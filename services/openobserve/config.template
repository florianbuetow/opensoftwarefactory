# Local-only credentials. The initializer replaces the password placeholder.
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=__GENERATE_PASSWORD__
ZO_DATA_DIR=/data
ZO_LOCAL_MODE=true
ZO_LOCAL_MODE_STORAGE=disk
ZO_META_STORE=sqlite
ZO_HTTP_PORT=5080
# Keep the local instance small; these are starting budgets, not capacity guarantees.
ZO_MEMORY_CACHE_ENABLED=false
ZO_MEMORY_CACHE_DATAFUSION_MAX_SIZE=128
ZO_MEM_TABLE_MAX_SIZE=64
ZO_MAX_FILE_SIZE_IN_MEMORY=32
ZO_COMPACT_FAST_MODE=false
ZO_HTTP_WORKER_NUM=1
ZO_QUERY_THREAD_NUM=1
ZO_FILE_MOVE_THREAD_NUM=1
ZO_FILE_MERGE_THREAD_NUM=1
ZO_MEM_DUMP_THREAD_NUM=1
# The pinned server treats zero as disabled retention; host archives also never expire.
ZO_COMPACT_DATA_RETENTION_DAYS=0
# Accept the full historical RFC3339 year range without changing occurrence timestamps.
ZO_INGEST_ALLOWED_UPTO=100000000
# Bound projection persistence/statistics lag on this local single-node installation.
ZO_MAX_FILE_RETENTION_TIME=10
ZO_CALCULATE_STATS_INTERVAL=10
ZO_USE_STREAM_SETTINGS_FOR_PARTITIONS_ENABLED=false
ZO_TELEMETRY=false
